# 'supabase' (default) or 'local'
DB_PROVIDER=supabase
NEXT_PUBLIC_DB_PROVIDER=supabase

# Required only when DB_PROVIDER=supabase:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=

# Enable debug logging (only for development)
DEBUG_MODE=false

# AI provider keys — set whichever providers you want to enable
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Required for BYOK (Bring Your Own Key) — encrypts stored API keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
